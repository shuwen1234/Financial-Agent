# 复制为 .env 后可本地运行；生产密钥从密钥管理系统注入。
APP_ENV=local
AUTH_MODE=local
LOCAL_DEMO_TOKEN=example-only
DATABASE_PATH=data/archives.db
BUSINESS_TIMEZONE=Asia/Shanghai
LLM_PROVIDER=extractive
OPENAI_MODEL=
OPENAI_API_KEY=
PROMPT_VERSION=v1
RERANKER_MODE=none
# 用标注数据校准后再填：RERANK_MIN_SCORE=
MIN_TOKEN_OVERLAP=2
MAX_UPLOAD_BYTES=10485760
MAX_RETRIEVAL_CANDIDATES=2000
